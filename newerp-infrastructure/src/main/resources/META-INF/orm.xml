<?xml version="1.0" encoding="UTF-8"?>
<!--
    JPA mapping of the domain classes to the tables, in XML instead of annotations, so the domain stays plain Java.
    This is the Java version of the EF Core Fluent API in ErpDbContext.<Module>.cs.
    Fields are read and written directly (access FIELD), private ones too. Column names in camelCase map to
    snake_case by themselves (sortOrder → sort_order); only the ones that differ are written out.
-->
<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping" version="7.0">

    <persistence-unit-metadata>
        <persistence-unit-defaults>
            <access>FIELD</access>
        </persistence-unit-defaults>
    </persistence-unit-metadata>

    <!-- Mapped superclass: its fields are columns of each subclass table; it is not an entity (no table, no hierarchy). -->
    <mapped-superclass class="ua.newerp.domain.cashbox.CashboxDirectoryEntry">
        <attributes>
            <id name="id"><generated-value strategy="IDENTITY"/></id>
            <basic name="name"/>
            <basic name="description"><column name="description" column-definition="text"/></basic>
            <basic name="dateAdded"/>
        </attributes>
    </mapped-superclass>

    <!-- ═══ Stock: tables of the old StockTrack module (dd_stock_*) ═══ -->

    <entity class="ua.newerp.domain.stock.StockCategory">
        <table name="dd_stock_categories"/>
        <attributes>
            <id name="id"><column name="category_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="name"/>
            <basic name="sortOrder"/>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.stock.StockSupplier">
        <table name="dd_stock_suppliers"/>
        <attributes>
            <id name="id"><column name="supplier_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="name"/>
            <basic name="phone"/>
            <basic name="email"/>
            <basic name="categories"/>
            <basic name="notes"><column name="notes" column-definition="text"/></basic>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.stock.StockItem">
        <table name="dd_stock_items"/>
        <attributes>
            <id name="id"><column name="item_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="categoryId"/>
            <basic name="supplierId"/>
            <basic name="name"/>
            <basic name="unit"/>
            <basic name="quantity"><column name="stock" precision="12" scale="3"/></basic>
            <basic name="minQuantity"><column name="min_stock" precision="12" scale="3"/></basic>
            <basic name="usedFor"/>
            <basic name="price"><column name="price" precision="15" scale="4"/></basic>
            <basic name="active"><column name="status"/></basic>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.stock.StockMovement">
        <table name="dd_stock_log"/>
        <attributes>
            <id name="id"><column name="log_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="itemName"/>
            <basic name="action"/>
            <basic name="quantity"><column name="quantity" precision="12" scale="3"/></basic>
            <basic name="stockBefore"><column name="stock_before" precision="12" scale="3"/></basic>
            <basic name="stockAfter"><column name="stock_after" precision="12" scale="3"/></basic>
            <basic name="comment"/>
            <basic name="userId"/>
            <basic name="username"/>
            <basic name="createdAt"><column name="date_added"/></basic>
            <many-to-one name="item" fetch="LAZY"><join-column name="item_id" nullable="false"/></many-to-one>
        </attributes>
    </entity>

    <!-- Stock per warehouse: our own tables. The main stock is the remainder of dd_stock_items.stock, it has no row. -->
    <entity class="ua.newerp.domain.stock.StockBalance">
        <table name="erp_stock_location"/>
        <attributes>
            <id name="id"><generated-value strategy="IDENTITY"/></id>
            <basic name="itemId"/>
            <basic name="warehouseId"/>
            <basic name="quantity"><column name="quantity" precision="12" scale="3"/></basic>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.stock.StockTransfer">
        <table name="erp_stock_transfer"/>
        <attributes>
            <id name="id"><generated-value strategy="IDENTITY"/></id>
            <basic name="itemId"/>
            <basic name="fromWarehouseId"/>
            <basic name="toWarehouseId"/>
            <basic name="quantity"><column name="quantity" precision="12" scale="3"/></basic>
            <basic name="comment"/>
            <basic name="userId"/>
            <basic name="username"/>
            <basic name="createdAt"/>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.production.SewnBalance">
        <table name="erp_production_location"/>
        <attributes>
            <id name="id"><generated-value strategy="IDENTITY"/></id>
            <basic name="sizeId"/>
            <basic name="warehouseId"/>
            <basic name="quantity"><column name="quantity" precision="12" scale="3"/></basic>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.production.SewnTransfer">
        <table name="erp_production_transfer"/>
        <attributes>
            <id name="id"><generated-value strategy="IDENTITY"/></id>
            <basic name="productionId"/>
            <basic name="sizeId"/>
            <basic name="fromWarehouseId"/>
            <basic name="toWarehouseId"/>
            <basic name="quantity"><column name="quantity" precision="12" scale="3"/></basic>
            <basic name="comment"/>
            <basic name="userId"/>
            <basic name="username"/>
            <basic name="createdAt"/>
        </attributes>
    </entity>

    <!-- Supplier orders: our own tables erp_purchase_order*; the old site has nothing like it. -->
    <entity class="ua.newerp.domain.stock.PurchaseOrder">
        <table name="erp_purchase_order"/>
        <attributes>
            <id name="id"><generated-value strategy="IDENTITY"/></id>
            <basic name="supplierId"/>
            <basic name="status"/>
            <basic name="comment"/>
            <basic name="createdByUserId"/>
            <basic name="createdAt"/>
            <basic name="orderedAt"/>
            <basic name="closedAt"/>
            <!-- Lines belong to the order: saved and deleted with it (cascade), removed lines are deleted (orphan-removal) -->
            <one-to-many name="lines" orphan-removal="true">
                <order-by>id</order-by>
                <join-column name="order_id" nullable="false"/>
                <cascade><cascade-all/></cascade>
            </one-to-many>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.stock.PurchaseOrderLine">
        <table name="erp_purchase_order_line"/>
        <attributes>
            <id name="id"><generated-value strategy="IDENTITY"/></id>
            <basic name="orderId"><column name="order_id" insertable="false" updatable="false"/></basic>
            <basic name="itemId"/>
            <basic name="quantity"><column name="quantity" precision="12" scale="3"/></basic>
            <basic name="price"><column name="price" precision="15" scale="4"/></basic>
            <basic name="receivedQuantity"><column name="received_quantity" precision="12" scale="3"/></basic>
        </attributes>
    </entity>

    <!-- ═══ Production: tables of the old StockTrack module (dd_stock_production*) ═══ -->

    <entity class="ua.newerp.domain.production.ProductionModel">
        <table name="dd_stock_production"/>
        <attributes>
            <id name="id"><column name="production_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="name"/>
            <basic name="type"/>
            <basic name="minTotal"/>
            <basic name="sortOrder"/>
            <basic name="active"><column name="status"/></basic>
            <one-to-many name="sizes" orphan-removal="true">
                <order-by>sortOrder</order-by>
                <join-column name="production_id" nullable="false"/>
                <cascade><cascade-all/></cascade>
            </one-to-many>
            <one-to-many name="sewnBom" orphan-removal="true">
                <order-by>id</order-by>
                <join-column name="production_id" nullable="false"/>
                <cascade><cascade-all/></cascade>
            </one-to-many>
            <!-- The link tables have no id of their own (key = production_id + product_id), so they are
                 element collections: values that belong to the model. On a change Hibernate rewrites the model's rows. -->
            <element-collection name="productLinks">
                <collection-table name="dd_stock_production_products">
                    <join-column name="production_id"/>
                </collection-table>
            </element-collection>
            <element-collection name="categoryLinks">
                <collection-table name="dd_stock_production_categories">
                    <join-column name="production_id"/>
                </collection-table>
            </element-collection>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.production.ProductionSize">
        <table name="dd_stock_production_sizes"/>
        <attributes>
            <id name="id"><column name="size_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="productionId"><column name="production_id" insertable="false" updatable="false"/></basic>
            <basic name="name"><column name="size_name"/></basic>
            <basic name="percent"><column name="percent" precision="5" scale="2"/></basic>
            <basic name="cutStock"><column name="cut_stock" precision="12" scale="3"/></basic>
            <basic name="sewnStock"><column name="sewn_stock" precision="12" scale="3"/></basic>
            <basic name="sortOrder"/>
            <basic name="optionValueId"><column name="oc_option_value_id"/></basic>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.production.SewnBomLine">
        <table name="dd_stock_production_sewn_bom"/>
        <attributes>
            <id name="id"><column name="bom_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="productionId"><column name="production_id" insertable="false" updatable="false"/></basic>
            <basic name="sizeId"/>
            <basic name="componentId"/>
            <basic name="itemId"/>
            <basic name="qtyPerUnit"><column name="qty_per_unit" precision="12" scale="4"/></basic>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.production.ProductionComponent">
        <table name="dd_stock_production_components"/>
        <attributes>
            <id name="id"><column name="component_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="productionId"/>
            <basic name="name"/>
            <basic name="sortOrder"/>
            <one-to-many name="bom" orphan-removal="true">
                <order-by>id</order-by>
                <join-column name="component_id" nullable="false"/>
                <cascade><cascade-all/></cascade>
            </one-to-many>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.production.ComponentBomLine">
        <table name="dd_stock_production_component_bom"/>
        <attributes>
            <id name="id"><column name="bom_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="componentId"><column name="component_id" insertable="false" updatable="false"/></basic>
            <basic name="sizeId"/>
            <basic name="itemId"/>
            <basic name="qtyPerUnit"><column name="qty_per_unit" precision="12" scale="4"/></basic>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.production.ComponentStock">
        <table name="dd_stock_production_component_stock"/>
        <id-class class="ua.newerp.infrastructure.production.ComponentStockId"/>
        <attributes>
            <id name="componentId"/>
            <id name="sizeId"/>
            <basic name="stock"><column name="stock" precision="12" scale="3"/></basic>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.production.ProductionLogEntry">
        <table name="dd_stock_production_log"/>
        <attributes>
            <id name="id"><column name="log_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="sizeName"/>
            <basic name="stage"/>
            <basic name="direction"/>
            <basic name="quantity"><column name="quantity" precision="12" scale="3"/></basic>
            <basic name="stockBefore"><column name="stock_before" precision="12" scale="3"/></basic>
            <basic name="stockAfter"><column name="stock_after" precision="12" scale="3"/></basic>
            <basic name="comment"/>
            <basic name="userId"/>
            <basic name="username"/>
            <basic name="createdAt"><column name="date_added"/></basic>
            <many-to-one name="model" fetch="LAZY"><join-column name="production_id" nullable="false"/></many-to-one>
            <many-to-one name="size" fetch="LAZY"><join-column name="size_id" nullable="false"/></many-to-one>
        </attributes>
    </entity>

    <!-- ═══ SMS: the old site's log dd_sms_log ═══ -->

    <entity class="ua.newerp.domain.sms.SmsMessage">
        <table name="dd_sms_log"/>
        <attributes>
            <id name="id"><column name="message_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="orderId"/>
            <basic name="preOrderId"/>
            <basic name="phone"/>
            <basic name="text"><column name="text" column-definition="text"/></basic>
            <basic name="response"><column name="response" column-definition="text"/></basic>
            <basic name="sentAt"><column name="date"/></basic>
        </attributes>
    </entity>

    <!-- ═══ Delivery: the old site's Nova Poshta waybills ═══ -->

    <entity class="ua.newerp.domain.delivery.ShipmentDocument">
        <table name="dd_novaposhta_document"/>
        <attributes>
            <id name="id"><generated-value strategy="IDENTITY"/></id>
            <basic name="orderId"/>
            <basic name="carrier"/>
            <basic name="ref"/>
            <basic name="number"/>
            <basic name="cost"><column name="cost" precision="15" scale="4"/></basic>
            <basic name="status"/>
            <basic name="statusCode"/>
            <basic name="recipientAddress"/>
            <basic name="redelivery"/>
            <basic name="dateCreated"/>
            <basic name="dateScheduled"/>
            <basic name="datePayedKeeping"/>
        </attributes>
    </entity>

    <!-- ═══ Cashbox: the old site's Checkbox tables. Columns with cashier keys are deliberately not mapped. ═══ -->

    <entity class="ua.newerp.domain.cashbox.Cashier">
        <table name="dd_cashbox_user"/>
        <attributes>
            <id name="id"><column name="user_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="name"/>
            <basic name="description"><column name="description" column-definition="text"/></basic>
            <basic name="paymentCode"/>
            <basic name="autoCloseTime"/>
            <basic name="warehouseId"/>
            <basic name="requisitesId"/>
            <basic name="active"><column name="status"/></basic>
            <basic name="dateAdded"/>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.cashbox.CashboxWarehouse">
        <table name="dd_cashbox_warehouse"/>
        <attribute-override name="id"><column name="warehouse_id"/></attribute-override>
    </entity>

    <entity class="ua.newerp.domain.cashbox.CashboxRequisites">
        <table name="dd_cashbox_requisites"/>
        <attribute-override name="id"><column name="requisites_id"/></attribute-override>
    </entity>

    <entity class="ua.newerp.domain.cashbox.WorkShift">
        <table name="dd_cashbox_work_shift"/>
        <attributes>
            <id name="id"><column name="work_shift_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="userId"/>
            <basic name="cashierId"><column name="cashbox_user_id"/></basic>
            <basic name="checkboxShiftId"/>
            <basic name="dateAdded"/>
            <basic name="dateStart"/>
            <basic name="dateEnd"/>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.cashbox.Cheque">
        <table name="dd_cashbox_cheque"/>
        <attributes>
            <id name="id"><column name="cheque_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="orderId"/>
            <basic name="cashierId"><column name="cashbox_user_id"/></basic>
            <basic name="warehouseId"><column name="cashbox_warehouse_id"/></basic>
            <basic name="requisitesId"><column name="cashbox_requisites_id"/></basic>
            <basic name="sum"><column name="sum" precision="15" scale="4"/></basic>
            <basic name="checkboxId"/>
            <basic name="workShiftId"><column name="cashbox_work_shift_id"/></basic>
            <basic name="reportId"><column name="cashbox_report_id"/></basic>
            <basic name="dateAdded"/>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.cashbox.ZReport">
        <table name="dd_cashbox_report"/>
        <attributes>
            <id name="id"><column name="report_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="userId"/>
            <basic name="cashierId"><column name="cashbox_user_id"/></basic>
            <basic name="checkboxReportId"><column name="z_report_id"/></basic>
            <basic name="dateAdded"/>
        </attributes>
    </entity>

    <!-- ═══ Payments: the old site's PrivatBank statement (amounts are text like "1500.00 UAH") ═══ -->

    <entity class="ua.newerp.domain.payments.BankPayment">
        <table name="dd_privatbank"/>
        <attributes>
            <id name="id"><column name="payment_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="orderId"/>
            <basic name="appCode"><column name="appcode"/></basic>
            <basic name="card"/>
            <basic name="amountText"><column name="amount"/></basic>
            <basic name="cardAmountText"><column name="cardamount"/></basic>
            <basic name="restText"><column name="rest"/></basic>
            <basic name="description"><column name="description" column-definition="text"/></basic>
            <basic name="terminal"/>
            <basic name="tranDate"><column name="trandate"/></basic>
            <basic name="tranTime"><column name="trantime"/></basic>
            <basic name="visible"><column name="show_status"/></basic>
        </attributes>
    </entity>

    <!-- Reseller partners of the old site (structure reconstructed, see db/reconstructed.sql). MyISAM without foreign keys:
         the mapping rows are deleted by Hibernate together with the partner (cascade on the Hibernate side). -->
    <entity class="ua.newerp.domain.partners.Partner">
        <table name="dd_partner"/>
        <attributes>
            <id name="id"><column name="partner_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="code"/>
            <basic name="name"/>
            <basic name="active"><column name="status"/></basic>
            <basic name="feedUrl"/>
            <basic name="feedEnabled"/>
            <basic name="vendorName"/>
            <basic name="notes"><column name="notes" column-definition="text"/></basic>
            <basic name="defaultQuantity"/>
            <basic name="dateAdded"/>
            <basic name="dateModified"/>
            <one-to-many name="categoryMap" orphan-removal="true">
                <order-by>id</order-by>
                <join-column name="partner_id" nullable="false"/>
                <cascade><cascade-all/></cascade>
            </one-to-many>
            <one-to-many name="productMap" orphan-removal="true">
                <order-by>id</order-by>
                <join-column name="partner_id" nullable="false"/>
                <cascade><cascade-all/></cascade>
            </one-to-many>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.partners.PartnerCategoryMap">
        <table name="dd_partner_category_map"/>
        <attributes>
            <id name="id"><column name="partner_category_map_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="categoryId"/>
            <basic name="sizeName"/>
            <basic name="externalId"/>
            <basic name="externalName"/>
            <basic name="percentSupply"><column precision="8" scale="2"/></basic>
            <basic name="percentSale"><column precision="8" scale="2"/></basic>
        </attributes>
    </entity>

    <entity class="ua.newerp.domain.partners.PartnerProductMap">
        <table name="dd_partner_product_map"/>
        <attributes>
            <id name="id"><column name="partner_product_map_id"/><generated-value strategy="IDENTITY"/></id>
            <basic name="productId"/>
            <basic name="sizeName"/>
            <basic name="externalId"/>
            <basic name="externalName"/>
            <basic name="priceSupply"><column precision="15" scale="4"/></basic>
            <basic name="priceSale"><column precision="15" scale="4"/></basic>
        </attributes>
    </entity>

    <!-- Embeddables go after all entities: the XML schema fixes the order of elements. -->
    <embeddable class="ua.newerp.domain.production.ProductionProductLink">
        <attributes>
            <basic name="productId"/>
            <transient name="productionId"/>
        </attributes>
    </embeddable>

    <embeddable class="ua.newerp.domain.production.ProductionCategoryLink">
        <attributes>
            <basic name="categoryId"><column name="oc_category_id"/></basic>
            <basic name="nameFilter"/>
            <basic name="matchExact"/>
            <transient name="productionId"/>
        </attributes>
    </embeddable>

</entity-mappings>
